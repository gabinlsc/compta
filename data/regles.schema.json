{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Règles réglementaires de Compta by glsc",
  "type": "object",
  "required": ["version", "entrees"],
  "properties": {
    "version": { "const": 1 },
    "description": { "type": "string" },
    "entrees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "libelle", "unite", "valeur", "statut", "source_url", "source_titre", "verifie_le", "valable_du", "valable_au"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "libelle": { "type": "string", "minLength": 5 },
          "unite": { "enum": ["pourcent", "euro", "date", "texte"] },
          "valeur": { "type": ["number", "string", "null"] },
          "statut": { "enum": ["verifie", "a_verifier"], "description": "« a_verifier » : valeur obligatoirement nulle, rien n'est publié. « verifie » : source officielle (https) et date de vérification obligatoires." },
          "source_url": { "type": ["string", "null"], "pattern": "^https://" },
          "source_titre": { "type": "string", "minLength": 3 },
          "verifie_le": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "valable_du": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "valable_au": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
